# Copy to .env and fill in. Never commit .env.
# These are the same key names the dividend project already uses, so you can
# copy the values across from there.

# DART Open API (https://opendart.fss.or.kr) — 공시·재무
DART_API_KEY=

# 공공데이터포털 KRX Open API (https://data.go.kr) — 시세·ETF universe
KRX_OPENAPI_KEY=

# 한국은행 ECOS (https://ecos.bok.or.kr) — 기준금리·물가·통화·환율
ECOS_API_KEY=

# KRX MDC 회원 로그인 — ETF 구성종목(PDF)에만 필요. 미설정 시 해당 기능만 비활성.
KRX_ID=
KRX_PW=

# --- 뉴스레터 블록 분류·주장 추출 -----------------------------------------
#
# 없어도 된다. 없으면 `topics mail` 이 정규식으로 추출하고, 넣으면 블록을
# 성격별로 가르고 주장을 다시 뽑는다. 숫자 없는 인과 문장이 여기서만 잡힌다.
#
# 실측 비용: 뉴스레터 5통/일 기준 분류 연 $5, 추출까지 합해 연 $30 안쪽이다.
# 모델을 잘게 나눠 라우팅해봐야 아끼는 돈이 월 몇 달러라 그렇게 하지 않았다.
# 결과를 바꾸고 싶으면 모델을 바꾸기보다 prompts/*.md 를 고치는 편이 낫다.
LLM_API_KEY=

# OpenAI 외 호환 엔드포인트를 쓸 때만. 비우면 기본값.
LLM_BASE_URL=

# 비우면 core/llm.py 의 DEFAULTS 를 쓴다. 분류는 대량이라 싼 모델로,
# 추출은 문맥을 봐야 해서 중간 모델로 나눠 뒀다.
MODEL_CLASSIFY=
MODEL_EXTRACT=
